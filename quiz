import os
import subprocess
import time
import argparse
import random

from obsidian import Vault
from crandom import randexp, rand
from ollama import Ollama

UNKNOWN = 0b0000
ALL = 0b0001
HARD = 0b0010
LATEST = 0b0100
OLDEST = 0b1000

UNIFORM = "uniform"
EXP_LATEST = "latest"
EXP_OLDEST = "oldest"

MODE_CLASSIC = "classic"
MODE_CREATIVE = "creative"
MODE_SIMILAR = "similar"


def select_choices(
    word_bank: list[str], answer: str, weights: list[float]
) -> list[str]:
    if len(word_bank) != len(weights):
        raise ValueError(
            "length of `word_bank` is expected to be equal to length of `weights`"
        )

    # Reduce the weight of answer choice
    i = word_bank.index(answer)
    weights[i] = max(weights[i] / 10, 0)

    correct_choice = random.choice(["a", "b", "c", "d", "e"])
    choices = []
    for choice in ["a", "b", "c", "d", "e"]:
        if choice == correct_choice:
            choices.append(answer)
        else:
            while True:
                i = rand(len(word_bank), weights)
                random_choice = word_bank[i]
                if random_choice != answer and random_choice not in choices:
                    choices.append(random_choice)
                    weights[i] = max(weights[i] / 10, 0)
                    break
    return choices


def clear_screen():
    command = "cls" if os.name == "nt" else "clear"
    subprocess.run(command)


def render_question(question_number: str, question: str, choices: list[str]):
    # Clear screen
    clear_screen()

    # Select one definition
    print()
    print(question_number)
    print("Q:", question)
    print()

    # Print options
    for i, choice in zip(["A", "B", "C", "D", "E"], choices):
        print(f"{i}) {choice}")
    print()


def render_thinking(question_number: str):
    # Clear screen
    clear_screen()

    # Select one definition
    print()
    print(question_number)
    print("Thinking...")


def parse_arg_take(take: str):
    if take == "all":
        return ALL, None
    elif take == "hard":
        return HARD, None
    elif take[0] == "l":
        count = int(take[1:])
        return LATEST, count
    elif take[0] == "o":
        count = int(take[1:])
        return OLDEST, count
    else:
        return UNKNOWN, None


def main():
    parser = argparse.ArgumentParser(
        prog="quiz", description="Quiz program for practising vocabulary"
    )

    parser.add_argument("-n", "--no", type=int, default=30)
    parser.add_argument(
        "-m",
        "--mode",
        type=str,
        default=MODE_SIMILAR,  # make similar mode as default, because SE and TC question requires us to match answer choices with our own word.
        choices=[MODE_CLASSIC, MODE_CREATIVE, MODE_SIMILAR],
    )
    parser.add_argument("-t", "--take", type=str, default="all")
    parser.add_argument("-s", "--sampling", type=str, default=UNIFORM)
    parser.add_argument("-d", "--debug", action="store_true")

    args = parser.parse_args()

    no = args.no
    mode = args.mode
    take, count = parse_arg_take(args.take)
    sampling = args.sampling

    # Vault instance
    lexicon_dir = os.getenv("LEXICON_DIR")
    if lexicon_dir is None:
        print("environment variable 'LEXICON_DIR' is not set")
        return
    vault = Vault(lexicon_dir)

    # Ollama instance
    ollama = Ollama()

    # Read from input file
    entries = vault.fetch_all_entries()

    # Sanity check
    if no <= 0:
        print(f"no. of question ({no}) must be positive integer")
        return

    if take == UNKNOWN:
        print(f"unknown take method '{args.take}'")
        return

    # no. of questions shouldn't exceed take count
    if count is not None:
        no = min(no, count)

    # Extract word bank
    word_bank = [entry.text for entry in entries]

    # Weights will be used for select_choices
    weights = [100.0 for _ in range(len(word_bank))]

    # take
    if take != ALL and count is not None:
        # sort the entries
        entries = sorted(entries, key=lambda e: e.ctime)

        if take == LATEST:
            entries = entries[-count:]
        elif take == OLDEST:
            entries = entries[:count]
    elif take == HARD:
        # need to load all the words in the vault to check whether marked as hard
        # can be slow in case of a lot of words.
        filtered_entries = []
        for entry in entries:
            word = vault.fetch_word(entry)
            if word is not None and word.marked_as_hard:
                filtered_entries.append(entry)
        entries = filtered_entries

    # Sanity check (after take is applied)
    if no > len(entries):
        print(f"no. of question ({no}) is greater than no. of entries ({len(entries)})")
        return

    # sampling
    if sampling != UNIFORM:
        # sort the entries
        if sampling == EXP_LATEST:
            entries = sorted(entries, key=lambda e: e.ctime)
        elif sampling == EXP_OLDEST:
            entries = sorted(entries, key=lambda e: -e.ctime)
        else:
            print(f"Unknown sampling method '{sampling}'")
            return

    # Welcome screen
    try:
        clear_screen()
        print("Welcome to Quiz2.0")
        print()
        print("number of questions:", no)
        print("mode:", args.mode)
        print("take:", args.take)
        print("sampling:", sampling)
        print()
        print(f"Loaded {len(entries)} words")
        print()
        if args.debug:
            print(", ".join([e.text for e in entries]))
            print()
        print("The quiz will began in ", end="", flush=True)
        for i in range(3, 0, -1):
            print(f"{i}... ", end="", flush=True)
            time.sleep(1)
        print("Start!")
        time.sleep(0.2)
    except KeyboardInterrupt:
        if not args.debug:
            clear_screen()
        return

    # start the quiz
    current = 0
    game_over = False
    while current < no and len(entries) > 0 and not game_over:
        # Randomly sample one entry
        if sampling == UNIFORM:
            # use uniform distribution
            i = random.randrange(len(entries))
        else:
            # use exponential distribution
            i = randexp(len(entries), lam=3)
        entry = entries[i]

        try:
            # Fetch word
            word = vault.fetch_word(entry)

            # Remove the entry
            entries.pop(i)

            # If word doesn't exist, remove it
            if word is None or len(word.definitions) == 0:
                continue

            definition = random.choice(word.definitions)
            if mode == MODE_CLASSIC:
                # use definition as the question
                question = definition
            if mode == MODE_SIMILAR:
                # use similar words as the question
                if word.similar_words:
                    similar_word = random.choice(word.similar_words)
                    question = f'Choose the word which is similar to "{similar_word}":'
                else:
                    # in case of no similar words, fallback to classic mode
                    question = definition
            else:
                try:
                    # use AI to generate a question from the definition
                    render_thinking(f"{current+1} of {no}")
                    question = ollama.generate_question(word.text, definition)
                except:
                    # in case of failure, fallback to classic mode
                    question = definition

            answer = entry.text
            choices = select_choices(word_bank, answer, weights)

            correct = False
            while not correct:
                render_question(f"{current+1} of {no}", question, choices)

                user_input = input("A: ").lower()
                if user_input == "\\exit":
                    raise KeyboardInterrupt
                elif user_input == "\\help":
                    if mode != MODE_CLASSIC:
                        print(f"H: {definition}\n")
                        input("Press enter to continue...")
                elif user_input == word.text.lower():
                    print("✓ Correct")
                    correct = True
                else:
                    print("x Incorrect")
                    time.sleep(0.5)

            current += 1

            if not game_over:
                # if word.similar_words:
                #     print()
                #     print("Similar words:", ", ".join(word.similar_words))
                time.sleep(1)

        except KeyboardInterrupt:
            clear_screen()
            game_over = True
            continue
        except:
            continue

    # Exit
    clear_screen()


if __name__ == "__main__":
    main()
